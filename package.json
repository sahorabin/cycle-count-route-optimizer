{
  "name": "cycle-count-route-optimizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A browser-based tool for planning warehouse cycle-count routes: pick locations, build a manual visit order, and compare it against a Dijkstra/nearest-neighbor/2-opt-generated recommended route.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahorabin/cycle-count-route-optimizer.git"
  },
  "keywords": [
    "route-optimization",
    "warehouse",
    "cycle-count",
    "inventory",
    "dijkstra",
    "nearest-neighbor",
    "2-opt",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
